<section id="instagram-videos-{{ section.id }}" class="ig-videos">
  <div class="ig-videos__header">
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>

  <div class="ig-videos__track">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      <article
        class="ig-card"
        data-ig-card
        data-title="{% if product != blank %}{{ product.title | escape }}{% else %}{{ block.settings.fallback_title | escape }}{% endif %}"
        data-price="{% if product != blank %}{{ product.price | money | escape }}{% endif %}"
        data-compare="{% if product != blank %}{{ product.compare_at_price | money | escape }}{% endif %}"
        data-description="{% if product != blank %}{{ product.description | strip_html | truncate: 220 | escape }}{% else %}{{ block.settings.fallback_description | escape }}{% endif %}"
        data-url="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}"
        data-discount="{{ block.settings.discount | escape }}"
        {{ block.shopify_attributes }}
      >
        <button
          type="button"
          class="ig-card__open"
          data-ig-open
          aria-label="Play video and view product"
        >
          <div class="ig-card__media">
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'ig-card__video'
              }}
            {% elsif block.settings.thumbnail != blank %}
              {{
                block.settings.thumbnail
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'ig-card__thumbnail'
              }}
            {% elsif product != blank and product.featured_image != blank %}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'ig-card__thumbnail'
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'ig-card__thumbnail' }}
            {% endif %}

            {% if block.settings.discount != blank %}
              <span class="ig-card__discount">
                {{ block.settings.discount | escape }}
              </span>
            {% endif %}

            <span class="ig-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5.5v13l10-6.5z"/>
              </svg>
            </span>
          </div>
        </button>

        <div class="ig-card__product">
          {% if product != blank and product.featured_image != blank %}
            <a href="{{ product.url }}" class="ig-card__avatar">
              {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
            </a>
          {% endif %}

          {% if product != blank %}
            <a href="{{ product.url }}" class="ig-card__title">
              {{ product.title | escape }}
            </a>

            <div class="ig-card__prices">
              <span class="ig-card__price">
                {{ product.price | money }}
              </span>

              {% if product.compare_at_price > product.price %}
                <s class="ig-card__compare">
                  {{ product.compare_at_price | money }}
                </s>
              {% endif %}
            </div>
          {% else %}
            <span class="ig-card__title">
              {{ block.settings.fallback_title | escape }}
            </span>

            <div class="ig-card__prices">
              {{ block.settings.fallback_description | escape }}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  <!-- Video Popup -->
  <div
    class="ig-modal"
    data-ig-modal
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Product video and details"
  >
    <button
      type="button"
      class="ig-modal__backdrop"
      data-ig-close
      aria-label="Close popup"
    ></button>

    <div class="ig-modal__dialog">
      <button
        type="button"
        class="ig-modal__close"
        data-ig-close
        aria-label="Close video"
      >
        &times;
      </button>

      <button
        type="button"
        class="ig-modal__nav ig-modal__nav--prev"
        data-ig-prev
        aria-label="Previous video"
      >
        &#10094;
      </button>

      <div class="ig-modal__video" data-ig-modal-video></div>

      <button
        type="button"
        class="ig-modal__nav ig-modal__nav--next"
        data-ig-next
        aria-label="Next video"
      >
        &#10095;
      </button>

      <div class="ig-modal__info">
        <div class="ig-modal__product">
          <div class="ig-modal__details">
            <h3 data-ig-title></h3>
            <p data-ig-description></p>

            <div class="ig-modal__prices">
              <span class="ig-modal__price" data-ig-price></span>
              <s class="ig-modal__compare" data-ig-compare></s>
            </div>
          </div>

          <a class="ig-modal__shop" data-ig-link href="#"> View Product </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #instagram-videos-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0
      {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }

  #instagram-videos-{{ section.id }} .ig-videos__header {
    text-align: center;
    padding: 0 20px;
    margin-bottom: 16px;
  }

  #instagram-videos-{{ section.id }} .ig-videos__header h2 {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.3;
    font-weight: 600;
  }

  #instagram-videos-{{ section.id }} .ig-videos__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 0 2.5%;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #instagram-videos-{{ section.id }} .ig-videos__track::-webkit-scrollbar {
    display: none;
  }

  #instagram-videos-{{ section.id }} .ig-card {
    flex: 0 0 18%;
    min-width: 0;
    border: 1px solid #dedede;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    color: #171717;
  }

  #instagram-videos-{{ section.id }} .ig-card__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  #instagram-videos-{{ section.id }} .ig-card__media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #eee;
  }

  #instagram-videos-{{ section.id }} .ig-card__video,
  #instagram-videos-{{ section.id }} .ig-card__thumbnail {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #instagram-videos-{{ section.id }} .ig-card__discount {
    position: absolute;
    top: 13px;
    left: 13px;
    z-index: 2;
    padding: 4px 12px;
    background: #c90000;
    color: #fff;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    border-radius: 5px 0 0 5px;
  }

  #instagram-videos-{{ section.id }} .ig-card__play {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.2s;
  }

  #instagram-videos-{{ section.id }} .ig-card__play svg {
    width: 22px;
    height: 22px;
  }

  #instagram-videos-{{ section.id }} .ig-card:hover .ig-card__play {
    opacity: 1;
  }

  #instagram-videos-{{ section.id }} .ig-card__product {
    position: relative;
    min-height: 98px;
    padding: 26px 10px 14px;
    text-align: center;
  }

  #instagram-videos-{{ section.id }} .ig-card__avatar {
    position: absolute;
    top: -26px;
    left: 50%;
    width: 58px;
    height: 58px;
    transform: translateX(-50%);
    overflow: hidden;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #eee;
    box-shadow: 0 2px 8px #00000012;
  }

  #instagram-videos-{{ section.id }} .ig-card__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #instagram-videos-{{ section.id }} .ig-card__title {
    display: block;
    overflow: hidden;
    color: inherit;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #instagram-videos-{{ section.id }} .ig-card__prices {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 7px;
    font-size: 15px;
  }

  #instagram-videos-{{ section.id }} .ig-card__price {
    color: #d00000;
    font-weight: 600;
  }

  #instagram-videos-{{ section.id }} .ig-card__compare {
    color: #aaa;
  }

  /* Popup */
  #instagram-videos-{{ section.id }} .ig-modal {
    position: fixed;
    z-index: 99999;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  #instagram-videos-{{ section.id }} .ig-modal.is-open {
    display: flex;
  }

  #instagram-videos-{{ section.id }} .ig-modal__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.8);
    cursor: default;
  }

  #instagram-videos-{{ section.id }} .ig-modal__dialog {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.8fr);
    width: min(900px, 100%);
    max-height: 90vh;
    overflow: auto;
    border-radius: 12px;
    background: #fff;
    color: #171717;
  }

  #instagram-videos-{{ section.id }} .ig-modal__video {
    position: relative;
    min-width: 0;
    min-height: 300px;
    max-height: 85vh;
    background: #111;
  }

  #instagram-videos-{{ section.id }} .ig-modal__video video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 85vh;
    object-fit: contain;
  }

  #instagram-videos-{{ section.id }} .ig-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #111;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  #instagram-videos-{{ section.id }} .ig-modal__nav {
    position: absolute;
    z-index: 4;
    top: 35%;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    cursor: pointer;
  }

  #instagram-videos-{{ section.id }} .ig-modal__nav--prev {
    left: 12px;
  }

  #instagram-videos-{{ section.id }} .ig-modal__nav--next {
    left: calc(100% - 54px);
  }

  #instagram-videos-{{ section.id }} .ig-modal__info {
    align-self: center;
    padding: 32px 24px;
  }

  #instagram-videos-{{ section.id }} .ig-modal__details h3 {
    margin: 0 0 12px;
    font-size: 23px;
    line-height: 1.3;
  }

  #instagram-videos-{{ section.id }} .ig-modal__details p {
    margin: 0 0 18px;
    color: #666;
    font-size: 14px;
    line-height: 1.6;
  }

  #instagram-videos-{{ section.id }} .ig-modal__prices {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  #instagram-videos-{{ section.id }} .ig-modal__price {
    color: #c00;
    font-size: 20px;
    font-weight: 600;
  }

  #instagram-videos-{{ section.id }} .ig-modal__compare {
    color: #999;
  }

  #instagram-videos-{{ section.id }} .ig-modal__shop {
    display: inline-block;
    padding: 13px 22px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 1100px) {
    #instagram-videos-{{ section.id }} .ig-card {
      flex-basis: 25%;
    }
  }

  @media (max-width: 767px) {
    #instagram-videos-{{ section.id }} .ig-videos__header h2 {
      font-size: 24px;
    }

    #instagram-videos-{{ section.id }} .ig-videos__track {
      gap: 12px;
      padding: 0 16px;
    }

    #instagram-videos-{{ section.id }} .ig-card {
      flex: 0 0 68%;
    }

    #instagram-videos-{{ section.id }} .ig-card__title {
      font-size: 14px;
    }

    #instagram-videos-{{ section.id }} .ig-modal {
      padding: 12px;
    }

    #instagram-videos-{{ section.id }} .ig-modal__dialog {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-height: 94vh;
    }

    #instagram-videos-{{ section.id }} .ig-modal__video {
      flex: 0 0 auto;
      height: 54vh;
      min-height: 220px;
      max-height: 58vh;
    }

    #instagram-videos-{{ section.id }} .ig-modal__video video {
      height: 100%;
      max-height: 58vh;
    }

    #instagram-videos-{{ section.id }} .ig-modal__nav {
      top: 27%;
      width: 36px;
      height: 36px;
    }

    #instagram-videos-{{ section.id }} .ig-modal__nav--next {
      left: auto;
      right: 10px;
    }

    #instagram-videos-{{ section.id }} .ig-modal__info {
      padding: 20px;
    }

    #instagram-videos-{{ section.id }} .ig-modal__details h3 {
      font-size: 19px;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('instagram-videos-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const modal = root.querySelector('[data-ig-modal]');
    const modalVideo = root.querySelector('[data-ig-modal-video]');
    const titleEl = root.querySelector('[data-ig-title]');
    const descriptionEl = root.querySelector('[data-ig-description]');
    const priceEl = root.querySelector('[data-ig-price]');
    const compareEl = root.querySelector('[data-ig-compare]');
    const linkEl = root.querySelector('[data-ig-link]');
    const cards = Array.from(root.querySelectorAll('[data-ig-card]'));

    let currentIndex = 0;
    let previousFocus = null;

    function updateModal(index) {
      if (!cards.length) return;

      currentIndex = (index + cards.length) % cards.length;
      const card = cards[currentIndex];
      const sourceVideo = card.querySelector('video');
      const thumbnail = card.querySelector('.ig-card__thumbnail');

      modalVideo.replaceChildren();

      if (sourceVideo) {
        const video = sourceVideo.cloneNode(true);
        video.removeAttribute('autoplay');
        video.controls = true;
        video.loop = true;
        video.muted = false;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('preload', 'metadata');
        modalVideo.appendChild(video);

        video.play().catch(() => {
          // User can start playback with the video controls.
        });
      } else if (thumbnail) {
        const image = thumbnail.cloneNode(true);
        image.style.width = '100%';
        image.style.height = '100%';
        image.style.objectFit = 'contain';
        modalVideo.appendChild(image);
      }

      titleEl.textContent = card.dataset.title || '';
      descriptionEl.textContent = card.dataset.description || '';
      priceEl.textContent = card.dataset.price || '';
      compareEl.textContent = card.dataset.compare || '';
      compareEl.hidden = !card.dataset.compare;
      linkEl.href = card.dataset.url || '#';
    }

    function openModal(index) {
      previousFocus = document.activeElement;
      updateModal(index);
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector('[data-ig-close]').focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modalVideo.querySelectorAll('video').forEach((video) => {
        video.pause();
        video.removeAttribute('src');
      });
      modalVideo.replaceChildren();
      document.body.style.overflow = '';
      if (previousFocus) previousFocus.focus();
    }

    cards.forEach((card, index) => {
      const video = card.querySelector('video');

      if (video) {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.play().catch(() => {
          // Browser autoplay policies may prevent playback.
        });
      }

      card.querySelector('[data-ig-open]').addEventListener('click', () => {
        openModal(index);
      });
    });

    modal.querySelectorAll('[data-ig-close]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal.querySelector('[data-ig-prev]').addEventListener('click', () => {
      updateModal(currentIndex - 1);
    });

    modal.querySelector('[data-ig-next]').addEventListener('click', () => {
      updateModal(currentIndex + 1);
    });

    document.addEventListener('keydown', (event) => {
      if (!modal.classList.contains('is-open')) return;

      if (event.key === 'Escape') closeModal();
      if (event.key === 'ArrowLeft') updateModal(currentIndex - 1);
      if (event.key === 'ArrowRight') updateModal(currentIndex + 1);
    });
  })();
</script>

{% schema %}
{
  "name": "Instagram Product Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Loved by Instagram Creators"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "video_product",
      "name": "Video product",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Upload Shopify video"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Fallback image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Discount badge",
          "default": "30% OFF"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback product title",
          "default": "Featured Product"
        },
        {
          "type": "text",
          "id": "fallback_description",
          "label": "Fallback description",
          "default": "Discover this collection."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Instagram Product Videos",
      "blocks": [
        { "type": "video_product" },
        { "type": "video_product" },
        { "type": "video_product" },
        { "type": "video_product" },
        { "type": "video_product" }
      ]
    }
  ]
}
{% endschema %}
