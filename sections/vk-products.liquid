
{% comment %}
  Section: New In Products
  Features:
  - Reusable collection product grid
  - Variant-based pricing and discount badge
  - Second image hover and optional zoom
  - Optional product ratings from Shopify review metafields
  - Optional product button with customizable text and colors
  - Responsive desktop, tablet and mobile layouts
{% endcomment %}

{{ 'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@500;600&display=swap' | stylesheet_tag }}

<style>
  #nip-{{ section.id }} {
    --nip-bg: {{ section.settings.bg }};
    --nip-text: {{ section.settings.text_color }};
    --nip-sub: {{ section.settings.sub_color }};
    --nip-badge-bg: {{ section.settings.badge_bg }};
    --nip-badge-text: {{ section.settings.badge_text }};
    --nip-radius: {{ section.settings.radius }}px;
    --nip-gap: {{ section.settings.gap }}px;
    --nip-scale: {{ section.settings.hover_scale | divided_by: 100.0 }};
    --nip-ratio: {{ section.settings.ratio }};
    --nip-star: {{ section.settings.star_color }};
    --nip-button-bg: {{ section.settings.button_bg }};
    --nip-button-text: {{ section.settings.button_text_color }};
    --nip-button-border: {{ section.settings.button_border }};

    background: var(--nip-bg);
    color: var(--nip-text);
    font-family: 'DM Sans', Arial, sans-serif;
    padding: {{ section.settings.pad_top }}px 5% {{ section.settings.pad_bottom }}px;
    box-sizing: border-box;
  }

  #nip-{{ section.id }} *,
  #nip-{{ section.id }} *::before,
  #nip-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #nip-{{ section.id }} .nip-head {
    text-align: center;
    margin-bottom: 32px;
  }

  #nip-{{ section.id }} .nip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.25;
    margin: 0 0 10px;
    text-transform: uppercase;
    color: var(--nip-text);
  }

  #nip-{{ section.id }} .nip-sub {
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
    color: var(--nip-sub);
  }
  #nip-{{ section.id }} .nip-tag {
    font-size: 16px;
    line-height: 1.7;
    font-weight: 700;
    margin: 0;
    color: var(--nip-sub);
  }
  #nip-{{ section.id }} .nip-grid {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    gap: var(--nip-gap);
    grid-template-columns: repeat({{ section.settings.cols_desktop }}, minmax(0, 1fr));
  }

  #nip-{{ section.id }} .nip-card {
    display: block;
    min-width: 0;
    color: inherit;
    text-align: center;
  }

  #nip-{{ section.id }} .nip-image-link,
  #nip-{{ section.id }} .nip-name-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #nip-{{ section.id }} .nip-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--nip-radius);
    aspect-ratio: var(--nip-ratio);
    background: rgba(0, 0, 0, 0.04);
    isolation: isolate;
  }

  #nip-{{ section.id }} .nip-media img,
  #nip-{{ section.id }} .nip-media svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease, transform 0.6s ease;
  }

  #nip-{{ section.id }} .nip-img1 {
    z-index: 0;
  }

  #nip-{{ section.id }} .nip-img2 {
    z-index: 1;
    opacity: 0;
  }

  #nip-{{ section.id }} .nip-placeholder {
    z-index: 0;
  }

  #nip-{{ section.id }} .nip-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    pointer-events: none;
  }

  #nip-{{ section.id }} .nip-badge {
    display: inline-block;
    background: var(--nip-badge-bg);
    color: var(--nip-badge-text);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    line-height: 1.3;
  }

  #nip-{{ section.id }} .nip-info {
    padding-top: 16px;
  }

  #nip-{{ section.id }} .nip-name {
    font-size: {{ section.settings.name_size }}px;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 8px;
    color: var(--nip-text);
    overflow-wrap: anywhere;
  }

  #nip-{{ section.id }} .nip-rating {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 9px;
    font-size: 12px;
  }

  #nip-{{ section.id }} .nip-stars {
    display: inline-flex;
    gap: 2px;
    color: #cccccc;
    letter-spacing: 0;
    font-size: 16px;
    line-height: 1;
  }

  #nip-{{ section.id }} .nip-star-filled {
    color: var(--nip-star);
  }

  #nip-{{ section.id }} .nip-rating-value,
  #nip-{{ section.id }} .nip-rating-count {
    color: var(--nip-sub);
  }

  #nip-{{ section.id }} .nip-price {
    font-size: 14px;
    font-weight: 700;
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  #nip-{{ section.id }} .nip-price s {
    font-weight: 500;
    opacity: 0.6;
  }

  #nip-{{ section.id }} .nip-button-wrap {
    display: flex;
    margin-top: 14px;
  }

  #nip-{{ section.id }} .nip-button-wrap.align-left {
    justify-content: flex-start;
  }

  #nip-{{ section.id }} .nip-button-wrap.align-center {
    justify-content: center;
  }

  #nip-{{ section.id }} .nip-button-wrap.align-right {
    justify-content: flex-end;
  }

  #nip-{{ section.id }} .nip-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 42px;
    padding: 10px 20px;
    background: var(--nip-button-bg);
    color: var(--nip-button-text);
    border: 1px solid var(--nip-button-border);
    border-radius: {{ section.settings.button_radius }}px;
    text-decoration: none;
    font-size: 13px;
    font-family: inherit;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    transition: opacity 0.2s ease, background 0.2s ease;
    cursor: pointer;
  }

  #nip-{{ section.id }} .nip-button:hover {
    opacity: 0.82;
  }

  #nip-{{ section.id }} .nip-button.full-width {
    width: 100%;
  }

  #nip-{{ section.id }} .nip-empty {
    text-align: center;
    opacity: 0.7;
    padding: 20px 0;
  }

  {% if section.settings.hover_mode != 'none' %}
    @media (hover: hover) and (pointer: fine) {
      {% if section.settings.hover_mode == 'swap' or section.settings.hover_mode == 'both' %}
        #nip-{{ section.id }} .nip-card:hover .nip-img2 {
          opacity: 1;
        }
      {% endif %}

      {% if section.settings.hover_mode == 'zoom' or section.settings.hover_mode == 'both' %}
        #nip-{{ section.id }} .nip-card:hover .nip-img1,
        #nip-{{ section.id }} .nip-card:hover .nip-img2 {
          transform: scale(var(--nip-scale));
        }
      {% endif %}
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    #nip-{{ section.id }} .nip-grid {
      grid-template-columns: repeat({{ section.settings.cols_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #nip-{{ section.id }} {
      padding-left: 4%;
      padding-right: 4%;
    }

    #nip-{{ section.id }} .nip-grid {
      grid-template-columns: repeat({{ section.settings.cols_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.gap | times: 0.7 | round }}px;
    }

    #nip-{{ section.id }} .nip-head {
      margin-bottom: 22px;
    }

    #nip-{{ section.id }} .nip-title {
      font-size: clamp(22px, 6vw, 30px);
    }

    #nip-{{ section.id }} .nip-name {
      font-size: {{ section.settings.name_size | minus: 2 }}px;
    }

    #nip-{{ section.id }} .nip-price {
      font-size: 13px;
      gap: 6px;
    }

    #nip-{{ section.id }} .nip-badges {
      top: 7px;
      left: 7px;
      gap: 4px;
    }

    #nip-{{ section.id }} .nip-badge {
      font-size: 10px;
      padding: 3px 8px;
      border-radius: 6px;
    }

    #nip-{{ section.id }} .nip-button {
      padding: 9px 12px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #nip-{{ section.id }} .nip-media img,
    #nip-{{ section.id }} .nip-media svg,
    #nip-{{ section.id }} .nip-button {
      transition: none;
    }
  }
</style>

<section id="nip-{{ section.id }}" class="nip">
  {% if section.settings.title != blank or section.settings.subtitle != blank or section.settings.offertag %}
    <div class="nip-head">
      {% if section.settings.title != blank %}
        <h2 class="nip-title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="nip-sub">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      {% if section.settings.offertag != blank %}
        <p class="nip-tag">{{ section.settings.offertag | escape }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="nip-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        {% if current_variant != blank %}
          {% assign current_price = current_variant.price %}
          {% assign compare_price = current_variant.compare_at_price %}
        {% else %}
          {% assign current_price = product.price %}
          {% assign compare_price = product.compare_at_price %}
        {% endif %}

        {% assign pct = 0 %}

        {% if compare_price != blank and compare_price > current_price %}
          {% assign pct = compare_price
            | minus: current_price
            | times: 100.0
            | divided_by: compare_price
            | round
          %}
        {% endif %}

        {% assign rating = product.metafields.reviews.rating.value %}
        {% assign rating_count = product.metafields.reviews.rating_count.value %}

        <article class="nip-card">
          <a class="nip-image-link" href="{{ product.url }}">
            <div class="nip-media">
              <div class="nip-badges">
                {% if section.settings.show_discount and pct > 0 %}
                  <span class="nip-badge">-{{ pct }}%</span>
                {% endif %}

                {% if section.settings.badge_label != blank %}
                  <span class="nip-badge">{{ section.settings.badge_label | escape }}</span>
                {% endif %}
              </div>

              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 800',
                    sizes: '(max-width: 749px) 48vw, (max-width: 989px) 33vw, 24vw',
                    class: 'nip-img1',
                    alt: product.title
                }}

                {% if product.images[1] != blank %}
                  {{
                    product.images[1]
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 800',
                      sizes: '(max-width: 749px) 48vw, (max-width: 989px) 33vw, 24vw',
                      class: 'nip-img2',
                      alt: ''
                  }}
                {% endif %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'nip-placeholder' }}
              {% endif %}
            </div>
          </a>

          <div class="nip-info">
            <a class="nip-name-link" href="{{ product.url }}">
              <h3 class="nip-name">{{ product.title | escape }}</h3>
            </a>

            {% comment %} {% if section.settings.show_rating and rating != blank %}
              <div class="nip-rating" aria-label="Rated {{ rating.rating }} out of {{ rating.scale_max }}">
                <span class="nip-stars" aria-hidden="true">
                  {% for star in (1..5) %}
                    {% if rating.rating >= star %}
                      <span class="nip-star-filled">★</span>
                    {% else %}
                      <span>★</span>
                    {% endif %}
                  {% endfor %}
                </span>

                {% if section.settings.show_rating_value %}
                  <span class="nip-rating-value">
                    {{ rating.rating | round: 1 }}/{{ rating.scale_max }}
                  </span>
                {% endif %}

                {% if section.settings.show_rating_count and rating_count != blank %}
                  <span class="nip-rating-count">
                    ({{ rating_count }})
                  </span>
                {% endif %}
              </div>
            {% endif %} {% endcomment %}

            <div class="nip-price">
              {% if compare_price != blank and compare_price > current_price %}
                <s>{{ compare_price | money }}</s>
              {% endif %}

              <span>{{ current_price | money }}</span>
            </div>

            {% if section.settings.show_button %}
              <div class="nip-button-wrap align-{{ section.settings.button_alignment }}">
                <a
                  class="nip-button{% if section.settings.button_full_width %} full-width{% endif %}"
                  href="{{ product.url }}"
                >
                  {{ section.settings.button_label | escape }}
                </a>
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="nip-empty">
      Select a collection in the Theme Editor to display products.
    </p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Vk Products",
  "tag": "section",
  "class": "section-new-in-products",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New In: Up to 10% Off"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtext",
      "default": "Discover our latest handcrafted pieces, freshly added to elevate your home with timeless style."
    },
    {
      "type": "textarea",
      "id": "offertag",
      "label": "Subtag",
      "default": "Discover our latest handcrafted pieces, freshly added to elevate your home with timeless style."
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Product title size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount percentage",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Second badge text (empty to hide)",
      "default": "New In"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#E59B12"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Product Ratings"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product ratings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating_value",
      "label": "Show numerical rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating_count",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#E5A000"
    },
    {
      "type": "paragraph",
      "content": "Ratings are displayed when the product has a rating in the standard reviews.rating metafield. Review counts use reviews.rating_count."
    },
    {
      "type": "header",
      "content": "Product Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show product button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "View Product"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Full-width button",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Section background",
      "default": "#FFF1E2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subtext color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns - Desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "cols_tablet",
      "label": "Columns - Tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Columns - Mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Image Hover Effect"
    },
    {
      "type": "select",
      "id": "hover_mode",
      "label": "Desktop hover",
      "default": "swap",
      "options": [
        {
          "value": "swap",
          "label": "Show second image"
        },
        {
          "value": "zoom",
          "label": "Zoom only"
        },
        {
          "value": "both",
          "label": "Second image and zoom"
        },
        {
          "value": "none",
          "label": "No effect"
        }
      ]
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Zoom scale",
      "min": 100,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 106
    }
  ],
  "presets": [
    {
      "name": "Vk Products"
    }
  ]
}
{% endschema %}
