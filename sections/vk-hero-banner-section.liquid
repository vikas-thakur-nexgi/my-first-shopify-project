
{%- comment -%}
  sections/editable-banner.liquid
  Editable slider banner with mobile-specific button class.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap' | stylesheet_tag }}

<style>
#eb-{{ section.id }} {
  --eb-bg: {{ section.settings.bg }};
  --eb-text: {{ section.settings.text_color }};
  --eb-accent: {{ section.settings.accent }};
  --eb-btn: {{ section.settings.btn_bg }};
  --eb-btn-text: {{ section.settings.btn_text }};
  --eb-h: {{ section.settings.height_desktop }}px;

  position: relative;
  overflow: hidden;
  background: var(--eb-bg);
  color: var(--eb-text);
  {% comment %} font-family: 'Roboto', Arial, sans-serif; {% endcomment %}
}

#eb-{{ section.id }} .eb-track {
  display: flex;
  transition: transform .6s ease;
  will-change: transform;
}

#eb-{{ section.id }} .eb-slide {
  position: relative;
  isolation: isolate;
  min-width: 100%;
  min-height: var(--eb-h);
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  align-items: center;
  gap: 24px;
  padding: 40px 6%;
  box-sizing: border-box;
}

#eb-{{ section.id }} .eb-bg,
#eb-{{ section.id }} .eb-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
}

#eb-{{ section.id }} .eb-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: {{ section.settings.bg_position }};
}

#eb-{{ section.id }} .eb-overlay {
  background: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
}

#eb-{{ section.id }} .eb-tag {
  color: var(--eb-accent);
  font-weight: 700;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: .4px;
}

#eb-{{ section.id }} .eb-title {
  font-size: clamp(34px, 5vw, 64px);
  line-height: 1.05;
  font-weight: 900;
  margin: 12px 0;
  color: var(--eb-text);
}

#eb-{{ section.id }} .eb-sub {
  font-size: 16px;
  opacity: .75;
  margin: 0 0 24px;
}

#eb-{{ section.id }} .eb-btn {
  display: inline-block;
  background: var(--eb-btn);
  color: var(--eb-btn-text);
  padding: 13px 30px;
  border-radius: 30px;
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  text-decoration: none;
  transition: opacity .3s ease, transform .3s ease;
}

#eb-{{ section.id }} .eb-btn:hover {
  opacity: .85;
  transform: translateY(-2px);
}

#eb-{{ section.id }} .eb-img {
  text-align: center;
}

#eb-{{ section.id }} .eb-img img,
#eb-{{ section.id }} .eb-img svg {
  max-width: 100%;
  height: auto;
  max-height: 420px;
  object-fit: contain;
  {% if section.settings.blend %}
    mix-blend-mode: multiply;
  {% endif %}
}

#eb-{{ section.id }} .eb-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 0;
  background: #fff;
  color: #000;
  font-size: 20px;
  cursor: pointer;
  z-index: 3;
  line-height: 1;
}

#eb-{{ section.id }} .eb-prev {
  left: 12px;
}

#eb-{{ section.id }} .eb-next {
  right: 12px;
}

#eb-{{ section.id }} .eb-dots {
  position: absolute;
  bottom: 14px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 8px;
  z-index: 3;
}

#eb-{{ section.id }} .eb-dots button {
  width: 10px;
  height: 10px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: rgba(0, 0, 0, .25);
  cursor: pointer;
  transition: .3s;
}

#eb-{{ section.id }} .eb-dots button.is-active {
  background: var(--eb-text);
  width: 26px;
}

/* Tablet */
@media (max-width: 989px) {
  #eb-{{ section.id }} {
    --eb-h: {{ section.settings.height_tablet }}px;
  }

  #eb-{{ section.id }} .eb-slide {
    gap: 16px;
    padding: 32px 8%;
  }

  #eb-{{ section.id }} .eb-img img,
  #eb-{{ section.id }} .eb-img svg {
    max-height: 320px;
  }

  #eb-{{ section.id }} .eb-sub {
    font-size: 15px;
  }
}

/* Mobile */
@media (max-width: 749px) {
  #eb-{{ section.id }} {
    --eb-h: {{ section.settings.height_mobile }}px;
  }

  #eb-{{ section.id }} .eb-slide {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 28px 20px 56px;
    gap: 12px;
  }

  #eb-{{ section.id }} .eb-img {
    order: -1;
  }

  #eb-{{ section.id }} .eb-img img,
  #eb-{{ section.id }} .eb-img svg {
    max-height: 240px;
  }

  #eb-{{ section.id }} .eb-nav {
    width: 34px;
    height: 34px;
    font-size: 16px;
    display: none;
  }

  /* Mobile-specific button styling */
  #eb-{{ section.id }} .eb-btn--mobile {
    display: inline-block;
    padding: 12px 26px;
    font-size: 13px;
    border-radius: 30px;
    max-width: 100%;
    box-sizing: border-box;
  }
}
</style>

<section
  id="eb-{{ section.id }}"
  class="eb"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
>
  <div class="eb-track">
    {%- for block in section.blocks -%}
      <div class="eb-slide" {{ block.shopify_attributes }}>

        {%- if block.settings.bg_image != blank -%}
          {{
            block.settings.bg_image
            | image_url: width: 2000
            | image_tag:
              class: 'eb-bg',
              loading: 'lazy',
              widths: '750, 1100, 1500, 2000',
              sizes: '100vw',
              alt: ''
          }}
          <div class="eb-overlay"></div>
        {%- endif -%}

        <div class="eb-text">
          {%- if block.settings.tag != blank -%}
            <div class="eb-tag">{{ block.settings.tag }}</div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h2 class="eb-title">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.subtext != blank -%}
            <p class="eb-sub">{{ block.settings.subtext }}</p>
          {%- endif -%}

          {%- if block.settings.btn_label != blank -%}
            <a
              class="eb-btn eb-btn--mobile"
              href="{{ block.settings.btn_link | default: '#' }}"
            >
              {{ block.settings.btn_label | escape }}
            </a>
          {%- endif -%}
        </div>

        <div class="eb-img">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1100',
                sizes: '(max-width: 749px) 90vw, 55vw',
                alt: block.settings.image.alt
            }}
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button
      type="button"
      class="eb-nav eb-prev"
      aria-label="Previous slide"
    >
      &#8249;
    </button>

    <button
      type="button"
      class="eb-nav eb-next"
      aria-label="Next slide"
    >
      &#8250;
    </button>

    <div class="eb-dots">
      {%- for block in section.blocks -%}
        <button
          type="button"
          aria-label="Slide {{ forloop.index }}"
          {% if forloop.first %}class="is-active"{% endif %}
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('eb-{{ section.id }}');

  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  var track = root.querySelector('.eb-track');
  var slides = root.querySelectorAll('.eb-slide');
  var dots = root.querySelectorAll('.eb-dots button');
  var current = 0;
  var timer;
  var startX = 0;

  if (!track || !slides.length) return;

  function go(index) {
    current = (index + slides.length) % slides.length;

    track.style.transform = 'translateX(-' + current * 100 + '%)';

    dots.forEach(function (dot, i) {
      var active = i === current;

      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-current', active ? 'true' : 'false');
    });
  }

  function stop() {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  }

  function play() {
    stop();

    if (
      root.dataset.autoplay === 'true' &&
      slides.length > 1 &&
      !(window.Shopify && Shopify.designMode)
    ) {
      timer = setInterval(function () {
        go(current + 1);
      }, Number(root.dataset.speed) || 5000);
    }
  }

  var previous = root.querySelector('.eb-prev');
  var next = root.querySelector('.eb-next');

  if (previous) {
    previous.addEventListener('click', function () {
      go(current - 1);
      play();
    });
  }

  if (next) {
    next.addEventListener('click', function () {
      go(current + 1);
      play();
    });
  }

  dots.forEach(function (dot, index) {
    dot.addEventListener('click', function () {
      go(index);
      play();
    });
  });

  /* Touch swipe */
  root.addEventListener('touchstart', function (event) {
    if (event.touches.length) {
      startX = event.touches[0].clientX;
    }
  }, { passive: true });

  root.addEventListener('touchend', function (event) {
    if (!event.changedTouches.length) return;

    var difference = event.changedTouches[0].clientX - startX;

    if (Math.abs(difference) > 50 && slides.length > 1) {
      go(difference < 0 ? current + 1 : current - 1);
      play();
    }
  }, { passive: true });

  /* Shopify theme editor support */
  root.addEventListener('shopify:block:select', function (event) {
    stop();

    slides.forEach(function (slide, index) {
      if (
        slide === event.target ||
        slide.contains(event.target)
      ) {
        go(index);
      }
    });
  });

  root.addEventListener('shopify:block:deselect', play);

  go(0);
  play();
})();
</script>

{% schema %}
{
  "name": "Vk Banner Section",
  "tag": "section",
  "class": "section-editable-banner",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#e9e9e7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Tag / accent color",
      "default": "#ff7a00"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "blend",
      "label": "Blend image with background (white bg images)",
      "default": true
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background position",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Increase opacity to improve text readability over the background image."
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop min height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "height_tablet",
      "label": "Tablet min height",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile min height",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Change slide every",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag text",
          "default": "Get 20% Off"
        },
