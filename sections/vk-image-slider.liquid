<div id="ww-image-slider-{{ section.id }}" class="ww-image-slider">
  <div class="swiper ww-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="swiper-slide ww-slide"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.slide_image != blank %}
            {{
              block.settings.slide_image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500, 2000',
                sizes: '100vw',
                class: 'ww-slide-image'
            }}

          {% else %}
            <div class="ww-slide-placeholder">
              <span>Slide {{ forloop.index }}</span>
              <p>Select an image in the Theme Editor</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_pagination %}
      <div class="swiper-pagination"></div>
    {% endif %}
  </div>
</div>

<style>
  #ww-image-slider-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  #ww-image-slider-{{ section.id }} .ww-swiper {
    width: 100%;
    height: {{ section.settings.slider_height }}px;
  }

  #ww-image-slider-{{ section.id }} .ww-slide {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f3f3f3;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #e8e8e8;
    color: #333;
    text-align: center;
    padding: 20px;
    box-sizing: border-box;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder span {
    font-size: 24px;
    font-weight: 600;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder p {
    font-size: 14px;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination {
    right: 20px;
    left: auto;
    width: auto;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet {
    background: #fff;
    opacity: 0.6;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet-active {
    background: #fff;
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    #ww-image-slider-{{ section.id }} .ww-swiper {
      height: {{ section.settings.mobile_slider_height }}px;
    }
  }
</style>

<script>
  (function () {
    var sliderId = 'ww-image-slider-{{ section.id }}';
    var swiperUrl = 'https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.js';
    var swiperCssUrl = 'https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.css';

    function loadStylesheet() {
      if (document.querySelector('link[href="' + swiperCssUrl + '"]')) return;

      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = swiperCssUrl;
      document.head.appendChild(link);
    }

    function initWWSlider() {
      var container = document.getElementById(sliderId);

      if (!container) return;

      if (container.swiper) {
        container.swiper.destroy(true, true);
      }

      if (typeof Swiper === 'undefined') {
        if (!window.wwSwiperLoading) {
          window.wwSwiperLoading = true;

          var script = document.createElement('script');
          script.src = swiperUrl;
          script.onload = function () {
            window.wwSwiperLoading = false;
            initWWSlider();
          };
          script.onerror = function () {
            window.wwSwiperLoading = false;
            console.error('Swiper could not be loaded.');
          };

          document.head.appendChild(script);
        } else {
          var waitForSwiper = setInterval(function () {
            if (typeof Swiper !== 'undefined') {
              clearInterval(waitForSwiper);
              initWWSlider();
            }
          }, 100);

          setTimeout(function () {
            clearInterval(waitForSwiper);
          }, 10000);
        }

        return;
      }

      var swiperElement = container.querySelector('.ww-swiper');
      if (!swiperElement) return;

      var slideCount = swiperElement.querySelectorAll('.swiper-slide').length;

      if (slideCount === 0) return;

      var paginationElement = container.querySelector('.swiper-pagination');

      var slider = new Swiper(swiperElement, {
        direction: 'vertical',
        slidesPerView: 1,
        spaceBetween: 0,

        loop: false,
        rewind: false,
        speed: 700,

        allowTouchMove: true,
        mousewheel: true,

        keyboard: {
          enabled: true
        },

        {% if section.settings.show_pagination %}
        pagination: {
          el: paginationElement,
          clickable: true
        },
        {% endif %}

        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed | times: 1000 }},
          disableOnInteraction: false,
          stopOnLastSlide: true
        }
        {% endif %}
      });

      container.swiper = slider;
    }

    loadStylesheet();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWWSlider, {
        once: true
      });
    } else {
      initWWSlider();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initWWSlider();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        var container = document.getElementById(sliderId);

        if (container && container.swiper) {
          container.swiper.destroy(true, true);
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "WW Image Slider",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slider_height",
      "label": "Desktop Height",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_slider_height",
      "label": "Mobile Height",
      "min": 250,
      "max": 650,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "sec"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Pagination Dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Main Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Image Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
