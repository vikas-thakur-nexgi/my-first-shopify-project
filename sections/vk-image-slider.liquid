<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.css">

<div id="ww-image-slider-{{ section.id }}" class="ww-image-slider">
  <div class="swiper ww-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide ww-slide" {{ block.shopify_attributes }}>
          {% if block.settings.slide_image != blank %}
            {%- capture slide_inner -%}
              {{
                block.settings.slide_image
                | image_url: width: 2000
                | image_tag:
                  loading: forloop.first | ternary: 'eager', 'lazy',
                  fetchpriority: forloop.first | ternary: 'high', 'auto',
                  widths: '375, 550, 750, 1100, 1500, 2000',
                  sizes: '100vw',
                  class: 'ww-slide-image'
              }}
            {%- endcapture -%}

            {% if block.settings.slide_link != blank %}
              <a href="{{ block.settings.slide_link }}" class="ww-slide-link">{{ slide_inner }}</a>
            {% else %}
              {{ slide_inner }}
            {% endif %}
          {% else %}
            <div class="ww-slide-placeholder">
              <span>Slide {{ forloop.index }}</span>
              <p>Select an image in the Theme Editor</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_pagination %}
      <div class="swiper-pagination"></div>
    {% endif %}

    {% if section.settings.show_arrows %}
      <div class="swiper-button-prev" aria-label="Previous slide"></div>
      <div class="swiper-button-next" aria-label="Next slide"></div>
    {% endif %}
  </div>
</div>

<style>
  #ww-image-slider-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  #ww-image-slider-{{ section.id }} .ww-swiper {
    width: 100%;
    height: {{ section.settings.slider_height }}px;
    overflow: hidden;
    --swiper-theme-color: #fff;
    --swiper-navigation-color: #fff;
    --swiper-navigation-size: 22px;
  }

  #ww-image-slider-{{ section.id }} .ww-slide {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f3f3f3;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #e8e8e8;
    color: #333;
    text-align: center;
    padding: 20px;
    box-sizing: border-box;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder span {
    font-size: 24px;
    font-weight: 600;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder p {
    font-size: 14px;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: #fff;
    opacity: 0.55;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.35);
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet-active {
    opacity: 1;
  }

  #ww-image-slider-{{ section.id }} .swiper-button-prev,
  #ww-image-slider-{{ section.id }} .swiper-button-next {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    transition: background 0.2s;
  }

  #ww-image-slider-{{ section.id }} .swiper-button-prev:hover,
  #ww-image-slider-{{ section.id }} .swiper-button-next:hover {
    background: rgba(0, 0, 0, 0.6);
  }

  #ww-image-slider-{{ section.id }} .swiper-button-prev:after,
  #ww-image-slider-{{ section.id }} .swiper-button-next:after {
    font-size: 18px;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #ww-image-slider-{{ section.id }} .ww-swiper {
      height: {{ section.settings.mobile_slider_height }}px;
    }

    #ww-image-slider-{{ section.id }} .swiper-button-prev,
    #ww-image-slider-{{ section.id }} .swiper-button-next {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var sliderId = 'ww-image-slider-{{ section.id }}';
    var swiperUrl = 'https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.js';

    // Load Swiper only once, shared by every slider on the page
    function loadSwiper() {
      if (window.Swiper) return Promise.resolve();
      if (window.wwSwiperPromise) return window.wwSwiperPromise;

      window.wwSwiperPromise = new Promise(function (resolve, reject) {
        var script = document.createElement('script');
        script.src = swiperUrl;
        script.onload = resolve;
        script.onerror = function () {
          window.wwSwiperPromise = null;
          reject(new Error('Swiper could not be loaded.'));
        };
        document.head.appendChild(script);
      });

      return window.wwSwiperPromise;
    }

    function initWWSlider() {
      var container = document.getElementById(sliderId);
      if (!container) return;

      var swiperElement = container.querySelector('.ww-swiper');
      if (!swiperElement) return;

      if (swiperElement.swiper) swiperElement.swiper.destroy(true, true);

      var slideCount = swiperElement.querySelectorAll('.swiper-slide').length;
      if (slideCount === 0) return;

      var isVertical = '{{ section.settings.direction }}' === 'vertical';
      var single = slideCount < 2;

      var options = {
        direction: isVertical ? 'vertical' : 'horizontal',
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 700,
        rewind: !single,
        allowTouchMove: !single,
        // lets the page scroll normally when the slider is at its first/last slide
        touchReleaseOnEdges: true,
        keyboard: { enabled: false }
      };

      {% if section.settings.mousewheel %}
      options.mousewheel = { releaseOnEdges: true };
      {% endif %}

      {% if section.settings.show_pagination %}
      options.pagination = { el: container.querySelector('.swiper-pagination'), clickable: true };
      {% endif %}

      {% if section.settings.show_arrows %}
      options.navigation = {
        nextEl: container.querySelector('.swiper-button-next'),
        prevEl: container.querySelector('.swiper-button-prev')
      };
      {% endif %}

      {% if section.settings.autoplay %}
      if (!single) {
        options.autoplay = {
          delay: {{ section.settings.autoplay_speed | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        };
      }
      {% endif %}

      new Swiper(swiperElement, options);
    }

    function start() {
      loadSwiper().then(initWWSlider).catch(function (err) {
        console.error(err);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "WW Image Slider",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Slide direction",
      "options": [
        { "value": "horizontal", "label": "Horizontal (left / right)" },
        { "value": "vertical", "label": "Vertical (up / down)" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "slider_height",
      "label": "Desktop Height",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_slider_height",
      "label": "Mobile Height",
      "min": 250,
      "max": 650,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "sec"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows (desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mousewheel",
      "label": "Change slide with mouse wheel",
      "info": "Page scroll tab bhi chalega jab first ya last slide par ho.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Main Image"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Image Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
