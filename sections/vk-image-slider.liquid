
{{ 'https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.css' | stylesheet_tag }}

<div id="ww-image-slider-{{ section.id }}" class="ww-image-slider">
  <div class="swiper ww-swiper">
    <div class="swiper-wrapper">

      {% for i in (1..4) %}
        {% assign image_key = 'slide_' | append: i | append: '_image' %}
        {% assign slide_image = section.settings[image_key] %}

        <div class="swiper-slide ww-slide">
          {% if slide_image != blank %}
            {{
              slide_image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500, 2000',
                sizes: '100vw',
                class: 'ww-slide-image',
                alt: slide_image.alt
            }}
          {% else %}
            <div class="ww-slide-placeholder">
              <span>Slide {{ i }}</span>
              <p>Select Slide {{ i }} image in the Theme Editor</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}

    </div>

    {% comment %} <div class="swiper-pagination"></div> {% endcomment %}
  </div>
</div>

<style>
  #ww-image-slider-{{ section.id }} {
    width: 100%;
    overflow: hidden;
  }

  #ww-image-slider-{{ section.id }} .ww-swiper {
    width: 100%;
    height: {{ section.settings.slider_height }}px;
  }

  #ww-image-slider-{{ section.id }} .ww-slide {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f3f3f3;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #ww-image-slider-{{ section.id }} .ww-slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #e8e8e8;
    color: #333;
    text-align: center;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination {
    right: 20px;
    left: auto;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet {
    background: #fff;
    opacity: 0.6;
  }

  #ww-image-slider-{{ section.id }} .swiper-pagination-bullet-active {
    background: #fff;
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    #ww-image-slider-{{ section.id }} .ww-swiper {
      height: {{ section.settings.mobile_slider_height }}px;
    }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.js"></script>

<script>
  (() => {
    const sliderId = 'ww-image-slider-{{ section.id }}';

    function initWWSlider() {
      const container = document.getElementById(sliderId);

      if (!container || typeof Swiper === 'undefined') return;

      if (container.swiper) {
        container.swiper.destroy(true, true);
      }

      new Swiper(container.querySelector('.ww-swiper'), {
        direction: 'vertical',
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        speed: 700,

        pagination: {
          el: container.querySelector('.swiper-pagination'),
          clickable: true
        },

        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed | times: 1000 }},
          disableOnInteraction: false
        },
        {% endif %}

        mousewheel: true,
        keyboard: {
          enabled: true
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWWSlider, {
        once: true
      });
    } else {
      initWWSlider();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initWWSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "WW Image Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slide Images"
    },
    {
      "type": "image_picker",
      "id": "slide_1_image",
      "label": "Slide 1 Main Image"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Slide 2 Main Image"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Slide 3 Main Image"
    },
    {
      "type": "image_picker",
      "id": "slide_4_image",
      "label": "Slide 4 Main Image"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slider_height",
      "label": "Desktop Height",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_slider_height",
      "label": "Mobile Height",
      "min": 250,
      "max": 650,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "sec"
    }
  ],
  "presets": [
    {
      "name": "WW Image Slider"
    }
  ]
}
{% endschema %}
