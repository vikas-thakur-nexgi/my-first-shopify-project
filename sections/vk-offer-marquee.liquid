
{%- comment -%}
  File: sections/text-marquee.liquid
  Reusable, responsive, seamless scrolling text marquee.
  Each text is a block with an optional link.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

{%- liquid
  case section.settings.separator
    when 'star'
      assign sep = '&#10040;'
    when 'dot'
      assign sep = '&#9679;'
    when 'diamond'
      assign sep = '&#9670;'
    when 'spark'
      assign sep = '&#10022;'
    when 'slash'
      assign sep = '/'
    when 'custom'
      assign sep = section.settings.custom_sep
    else
      assign sep = ''
  endcase
-%}

<style>
  #mq-{{ section.id }} {
    --mq-bg: {{ section.settings.bg }};
    --mq-text: {{ section.settings.text_color }};
    --mq-sep: {{ section.settings.sep_color }};
    --mq-size: {{ section.settings.font_size }}px;
    --mq-gap: {{ section.settings.gap }}px;
    --mq-speed: {{ section.settings.speed }}s;

    width: 100%;
    box-sizing: border-box;
    background: var(--mq-bg);
    color: var(--mq-text);
    {% comment %} font-family: 'Roboto', Arial, sans-serif; {% endcomment %}
    padding: {{ section.settings.pad_y }}px 0;
    overflow: hidden;
    position: relative;
  }

  #mq-{{ section.id }} .mq-track {
    display: flex;
    width: max-content;
    animation: mq-scroll-{{ section.id }} var(--mq-speed) linear infinite;
    will-change: transform;
  }

  #mq-{{ section.id }} .mq-group {
    flex: 0 0 auto;
    min-width: 100%;
    display: flex;
    align-items: center;
  }

  #mq-{{ section.id }} .mq-item {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mq-gap);
    padding-right: var(--mq-gap);
    white-space: nowrap;
  }

  #mq-{{ section.id }} .mq-text {
    font-size: var(--mq-size);
    font-weight: {{ section.settings.weight }};
    color: var(--mq-text);
    text-decoration: none;
    line-height: 1.4;
  }

  #mq-{{ section.id }} a.mq-text:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  #mq-{{ section.id }} .mq-sep {
    font-size: calc(var(--mq-size) * 0.6);
    color: var(--mq-sep);
    line-height: 1;
    flex: 0 0 auto;
  }

  {% if section.settings.border %}
    #mq-{{ section.id }} {
      border-top: 1px solid {{ section.settings.sep_color }};
      border-bottom: 1px solid {{ section.settings.sep_color }};
    }
  {% endif %}

  {% if section.settings.pause %}
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      #mq-{{ section.id }}:hover .mq-track {
        animation-play-state: paused;
      }
    }
  {% endif %}

  {% if section.settings.direction == 'right' %}
    @keyframes mq-scroll-{{ section.id }} {
      from {
        transform: translateX(-50%);
      }
      to {
        transform: translateX(0);
      }
    }
  {% else %}
    @keyframes mq-scroll-{{ section.id }} {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
  {% endif %}

  @media (max-width: 989px) {
    #mq-{{ section.id }} {
      --mq-size: {{ section.settings.font_size_tablet }}px;
      --mq-gap: {{ section.settings.gap | times: 0.8 | round }}px;
    }
  }

  @media (max-width: 749px) {
    #mq-{{ section.id }} {
      --mq-size: {{ section.settings.font_size_mobile }}px;
      --mq-gap: {{ section.settings.gap | times: 0.6 | round }}px;
      --mq-speed: {{ section.settings.speed | times: 0.8 | round }}s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mq-{{ section.id }} .mq-track {
      animation: none;
      transform: none;
      width: 100%;
    }

    #mq-{{ section.id }} .mq-group[aria-hidden="true"] {
      display: none;
    }

    #mq-{{ section.id }} .mq-group {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }
  }
</style>

<div
  id="mq-{{ section.id }}"
  class="mq"
  role="region"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="mq-track">
    {%- for i in (1..2) -%}
      <div
        class="mq-group"
        {% if i == 2 %}
          aria-hidden="true"
        {% endif %}
      >
        {%- for r in (1..section.settings.repeat) -%}
          {%- for block in section.blocks -%}
            <div
              class="mq-item"
              {% if i == 1 and r == 1 %}
                {{ block.shopify_attributes }}
              {% endif %}
            >
              {%- if block.settings.link != blank -%}
                <a
                  class="mq-text"
                  href="{{ block.settings.link }}"
                  {% if block.settings.new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                  {% if i == 2 %}
                    tabindex="-1"
                  {% endif %}
                >
                  {{ block.settings.text | escape }}
                </a>
              {%- else -%}
                <span class="mq-text">
                  {{ block.settings.text | escape }}
                </span>
              {%- endif -%}

              {%- if sep != blank -%}
                <span class="mq-sep" aria-hidden="true">{{ sep }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Vk Offer Marquee",
  "tag": "section",
  "class": "section-text-marquee",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store announcements"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll time (lower = faster)",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause",
      "label": "Pause on hover (desktop)",
      "default": true
    },
    {
      "type": "range",
      "id": "repeat",
      "label": "Repeat texts",
      "info": "Increase this when you have fewer text blocks.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator style",
      "default": "star",
      "options": [
        {
          "value": "star",
          "label": "Star ✸"
        },
        {
          "value": "spark",
          "label": "Sparkle ✦"
        },
        {
          "value": "dot",
          "label": "Dot ●"
        },
        {
          "value": "diamond",
          "label": "Diamond ◆"
        },
        {
          "value": "slash",
          "label": "Slash /"
        },
        {
          "value": "custom",
          "label": "Custom text"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_sep",
      "label": "Custom separator",
      "default": "|"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF1E2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "sep_color",
      "label": "Separator color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Text weight",
      "default": "400",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size - Desktop",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "font_size_tablet",
      "label": "Text size - Tablet",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Text size - Mobile",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between texts",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Top / bottom padding",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "Show top and bottom borders",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $299"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Add a link to make this text clickable."
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vk offer Marquee",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Easy returns within 14 days"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Free shipping on orders over $299"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Lowest Price Guarantee"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Longest Warranties"
          }
        }
      ]
    }
  ]
}
{% endschema %}
