      "default": false
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Text when timer ends",
      "default": "This offer has ended."
    },
    {
      "type": "text",
      "id": "lbl_days",
      "label": "Label - Days",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "lbl_hours",
      "label": "Label - Hours",
      "default": "Hrs"
    },
    {
      "type": "text",
      "id": "lbl_minutes",
      "label": "Label - Minutes",
      "default": "Min"
    },
    {
      "type": "text",
      "id": "lbl_seconds",
      "label": "Label - Seconds",
      "default": "Sec"
    },

    {
      "type": "header",
      "content": "Background image"
