              "settings": {
                "custom_liquid": "<style>\n  .custom-promo-box {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background-color: #f5efe0;\n    border: 1px dashed #c2b59b;\n    padding: 12px 16px;\n    border-radius: 4px;\n    font-family: inherit;\n  }\n\n  .custom-promo-text {\n    color: #4a4036;\n    font-size: 14px;\n    font-weight: 400;\n    margin: 0;\n    line-height: 1.4;\n  }\n\n  .custom-promo-code {\n    font-weight: 700;\n    color: #123d2b;\n  }\n\n  .custom-copy-btn {\n    background-color: #123d2b;\n    color: #ffffff;\n    border: none;\n    padding: 8px 16px;\n    font-size: 13px;\n    font-weight: 600;\n    border-radius: 4px;\n    cursor: pointer;\n    white-space: nowrap;\n    margin-left: 12px;\n    transition: background-color 0.2s ease;\n  }\n\n  .custom-copy-btn:hover {\n    background-color: #1b573e;\n  }\n\n  @media (max-width: 480px) {\n    .custom-promo-box {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 10px;\n    }\n    .custom-copy-btn {\n      width: 100%;\n      margin-left: 0;\n      text-align: center;\n    }\n  }\n</style>\n\n<!-- Yeh raha aapka updated text aur discount code -->\n{%- assign discount_text = \"Buy 2 items, get 10% off — code\" -%}\n{%- assign discount_code = \"BUY2\" -%}\n\n<div class=\"custom-promo-box\">\n  <p class=\"custom-promo-text\">\n    {{ discount_text }} <span class=\"custom-promo-code\" id=\"codeToCopy\">{{ discount_code }}</span>\n  </p>\n  <button type=\"button\" class=\"custom-copy-btn\" onclick=\"copyPromoCode(this, '{{ discount_code }}')\">COPY</button>\n</div>\n\n<script>\n  function copyPromoCode(button, code) {\n    navigator.clipboard.writeText(code).then(function() {\n      let originalText = button.innerText;\n      button.innerText = \"COPIED!\";\n      button.style.backgroundColor = \"#276b50\";\n      \n      setTimeout(function() {\n        button.innerText = originalText;\n        button.style.backgroundColor = \"#123d2b\";\n      }, 2000);\n    }).catch(function(err) {\n      console.error('Failed to copy text: ', err);\n    });\n  }\n</script>"
