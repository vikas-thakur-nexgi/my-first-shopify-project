            },
            "custom_liquid_GDtRjG": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  .countdown-banner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background-color: #123d2b; /* Dark green theme color */\n    color: #f5efe0; /* Cream text color */\n    padding: 14px 24px;\n    border-radius: 4px;\n    margin: 12px 0;\n    font-family: inherit;\n  }\n\n  .countdown-text {\n    font-size: 12px;\n    font-weight: 500;\n    margin: 0;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .countdown-timer {\n    font-size: 12px;\n    font-weight: 500;\n    margin: 0;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n    white-space: nowrap;\n  }\n\n  @media (max-width: 768px) {\n    .countdown-banner {\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n      gap: 10px;\n      padding: 16px;\n    }\n  }\n</style>\n\n<div class=\"countdown-banner\">\n  <p class=\"countdown-text\">Festive Collection · Limited Restock</p>\n  <p class=\"countdown-timer\" id=\"saleCountdown\">Ends in --h --m --s</p>\n</div>\n\n<script>\n  // Yahan apna end date aur time set karein (Format: Year, Month-1, Day, Hour, Minute)\n  // Jaise niche 5 din aage ki date set hai:\n  const countDownDate = new Date().getTime() + (120 * 60 * 60 * 1000); // 120 Hours from now\n\n  const x = setInterval(function() {\n    const now = new Date().getTime();\n    const distance = countDownDate - now;\n\n    if (distance < 0) {\n      clearInterval(x);\n      document.getElementById(\"saleCountdown\").innerHTML = \"Offer Expired\";\n      return;\n    }\n\n    const hours = Math.floor(distance / (1000 * 60 * 60));\n    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n    const seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n    document.getElementById(\"saleCountdown\").innerHTML = \"Ends in \" + hours + \"h \" + minutes + \"m \" + seconds + \"s\";\n  }, 1000);\n</script>"
              },
              "blocks": {}
            },
