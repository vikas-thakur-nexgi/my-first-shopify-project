            "custom_liquid_GwUf3e": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  .delivery-info-container {\n    margin: 12px 0;\n    font-family: inherit;\n    color: #333333;\n    font-size: 12px;\n    line-height: 1.6;\n    background: #fff;\n    padding: 10px;\n  }\n\n  .delivery-info-text {\n    margin: 0 0 4px 0;\n  }\n\n  .delivery-info-bold {\n    font-weight: 700;\n  }\n</style>\n\n<div class=\"delivery-info-container\">\n  <p class=\"delivery-info-text\">\n    <span class=\"delivery-info-bold\">Delivery - The expected delivery time is 4–6 business working days. 7 day Return\n      and Exchange</span>\n  </p>\n</div>"
              },
              "blocks": {}
            },
            "custom_liquid_Nchc86": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"ww-delivery-checker\">\n  <form id=\"ww-delivery-form\" class=\"ww-delivery-form\">\n    <label for=\"ww-pincode\" class=\"ww-delivery-title\">\n      Check delivery to your area\n    </label>\n\n    <div class=\"ww-delivery-input-row\">\n      <input\n        type=\"text\"\n        id=\"ww-pincode\"\n        name=\"pincode\"\n        placeholder=\"Enter 6-digit pincode\"\n        maxlength=\"6\"\n        inputmode=\"numeric\"\n        pattern=\"[0-9]{6}\"\n        autocomplete=\"postal-code\"\n        aria-describedby=\"ww-delivery-result\"\n        required\n      >\n\n      <button type=\"submit\" id=\"ww-check-button\">\n        Check\n      </button>\n    </div>\n\n    <div\n      id=\"ww-delivery-result\"\n      class=\"ww-delivery-result\"\n      role=\"status\"\n      aria-live=\"polite\"\n      hidden\n    ></div>\n  </form>\n</div>\n\n<style>\n  .ww-delivery-checker {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    font-family: inherit;\n    color: #111;\n  }\n\n  .ww-delivery-form {\n    width: 100%;\n  }\n\n  .ww-delivery-title {\n    display: block;\n    margin-bottom: 11px;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1.4;\n    color: #111;\n  }\n\n  .ww-delivery-input-row {\n    display: flex;\n    align-items: stretch;\n    gap: 10px;\n    width: 100%;\n  }\n\n  .ww-delivery-input-row input {\n    flex: 1;\n    width: 100%;\n    min-width: 0;\n    height: 46px;\n    padding: 0 15px;\n    border: 1px solid #d6d0c8;\n    border-radius: 6px;\n    background: #fff;\n    color: #111;\n    font-family: inherit;\n    font-size: 15px;\n    outline: none;\n    box-shadow: none;\n    box-sizing: border-box;\n  }\n\n  .ww-delivery-input-row input::placeholder {\n    color: #858585;\n    opacity: 1;\n  }\n\n  .ww-delivery-input-row input:focus {\n    border-color: #111;\n  }\n\n  .ww-delivery-input-row button {\n    flex-shrink: 0;\n    min-width: 90px;\n    height: 46px;\n    padding: 0 20px;\n    border: 1px solid #000;\n    border-radius: 6px;\n    background: #000;\n    color: #fff;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: background 0.2s ease;\n  }\n\n  .ww-delivery-input-row button:hover {\n    background: #333;\n  }\n\n  .ww-delivery-input-row button:disabled {\n    opacity: 0.7;\n    cursor: wait;\n  }\n\n  .ww-delivery-result {\n    margin-top: 12px;\n    padding: 12px 14px;\n    border-radius: 6px;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .ww-delivery-result[hidden] {\n    display: none;\n  }\n\n  .ww-delivery-result.ww-success {\n    color: #176b38;\n    background: #edf8f0;\n    border: 1px solid #c8e8d0;\n  }\n\n  .ww-delivery-result.ww-error {\n    color: #b42318;\n    background: #fff1f0;\n    border: 1px solid #f3c6c2;\n  }\n\n  .ww-delivery-result.ww-neutral {\n    color: #333;\n    background: #f5f5f5;\n    border: 1px solid #e5e5e5;\n  }\n\n  @media screen and (max-width: 480px) {\n    .ww-delivery-title {\n      font-size: 15px;\n    }\n\n    .ww-delivery-input-row {\n      gap: 8px;\n    }\n\n    .ww-delivery-input-row input {\n      height: 44px;\n      padding: 0 10px;\n      font-size: 14px;\n    }\n\n    .ww-delivery-input-row button {\n      min-width: 76px;\n      height: 44px;\n      padding: 0 13px;\n      font-size: 14px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  var form = document.getElementById('ww-delivery-form');\n\n  if (!form || form.dataset.initialized === 'true') return;\n  form.dataset.initialized = 'true';\n\n  var input = document.getElementById('ww-pincode');\n  var button = document.getElementById('ww-check-button');\n  var result = document.getElementById('ww-delivery-result');\n\n  /*\n   * DEMO PINCODES ONLY.\n   * Replace these with your verified serviceable pincodes.\n   */\n  var serviceablePincodes = [\n    '110059',\n    '110018',\n    '110027',\n    '110041',\n    '110043',\n    '110075',\n    '110078',\n    '110085',\n    '110086'\n  ];\n\n  input.addEventListener('input', function () {\n    this.value = this.value.replace(/\\D/g, '').slice(0, 6);\n    result.hidden = true;\n    result.textContent = '';\n  });\n\n  form.addEventListener('submit', function (event) {\n    event.preventDefault();\n\n    var pincode = input.value.trim();\n\n    result.hidden = false;\n    result.className = 'ww-delivery-result';\n\n    if (!/^[1-9][0-9]{5}$/.test(pincode)) {\n      result.classList.add('ww-error');\n      result.textContent =\n        'Please enter a valid 6-digit Indian pincode.';\n      input.focus();\n      return;\n    }\n\n    button.disabled = true;\n    button.textContent = 'Checking...';\n\n    // Demo check. Replace with a courier API for live results.\n    window.setTimeout(function () {\n      button.disabled = false;\n      button.textContent = 'Check';\n\n      if (serviceablePincodes.indexOf(pincode) !== -1) {\n        result.classList.add('ww-success');\n        result.textContent =\n          '✓ Great! Delivery is available to ' + pincode +\n          '. Estimated delivery: 3–5 business days (demo estimate).';\n      } else {\n        result.classList.add('ww-error');\n        result.textContent =\n          'Sorry, delivery is currently unavailable for ' +\n          pincode + '. Please check another pincode.';\n      }\n    }, 400);\n  });\n})();\n</script>"
              },
              "blocks": {}
            },
            "custom_liquid_paJDxp": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  .feature-grid-wrapper {\n    \n  }\n\n  .feature-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .feature-card {\n    background-color: #FFF1E2;\n    border-radius: 4px;\n    padding: 12px 4px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n  }\n\n  .feature-icon {\n    width: 25px;\n    height: 25px;\n    margin-bottom: 10px;\n    color: #123d2b;\n  }\n\n  .feature-text {\n    color: #4a4036;\n    font-size: 13px;\n    font-weight: 400;\n    text-underline-offset: 4px;\n    line-height: 1.3;\n    margin: 0;\n  }\n\n  @media (max-width: 768px) {\n    .feature-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 480px) {\n    .feature-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"feature-grid-wrapper\">\n  <div class=\"feature-grid\">\n    <!-- Item 1: Free Shipping -->\n    <div class=\"feature-card\">\n      <svg class=\"feature-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n        <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n        <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n      </svg>\n      <p class=\"feature-text\">Free Shipping Pan-India</p>\n    </div>\n\n    <!-- Item 2: Easy Exchange -->\n    <div class=\"feature-card\">\n      <svg class=\"feature-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path>\n        <path d=\"M3 3v5h5\"></path>\n      </svg>\n      <p class=\"feature-text\">7-Day Easy Exchange</p>\n    </div>\n\n    <!-- Item 3: Secure Payments -->\n    <div class=\"feature-card\">\n      <svg class=\"feature-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect>\n        <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path>\n      </svg>\n      <p class=\"feature-text\">100% Secure Payments</p>\n    </div>\n\n    <!-- Item 4: Cash on Delivery -->\n    <div class=\"feature-card\">\n      <svg class=\"feature-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"></rect>\n        <line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"></line>\n        <line x1=\"17\" y1=\"15\" x2=\"20\" y2=\"15\"></line>\n      </svg>\n      <p class=\"feature-text\">Cash on Delivery</p>\n    </div>\n  </div>\n</div>"
              },
