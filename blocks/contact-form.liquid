{% stylesheet %}

  /* Contact Information */
  .ww-contact-info {
    width: 100%;
    margin: 0 auto 40px;
    color: #111111;
    font-family: inherit;
  }

  .ww-contact-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 20px;
  }

  .ww-contact-company h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  .ww-contact-address,
  .ww-contact-gstin,
  .ww-contact-support p,
  .ww-contact-hours p {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .ww-contact-address {
    max-width: 650px;
    margin-bottom: 8px;
  }

  .ww-contact-gstin {
    margin-top: 8px;
  }

  .ww-contact-divider {
    width: 100%;
    height: 1px;
    background: #dedede;
    margin: 30px 0;
  }

  .ww-contact-details {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
  }

  .ww-contact-details h4 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 22px;
  }

  .ww-contact-support a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ww-contact-support a:hover {
    opacity: 0.7;
  }

  /* Contact Form */
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  /* Desktop Form Row */
  @media screen and (min-width: 750px) {
    .contact-form__form-row {
      flex-direction: row;
      align-items: center;
    }

    .contact-form__form-row > input {
      flex: 1;
      min-width: 0;
    }
  }

  /* Mobile Responsive */
  @media screen and (max-width: 749px) {
    .ww-contact-info {
      margin-bottom: 30px;
    }

    .ww-contact-title {
      font-size: 30px;
      margin-bottom: 30px;
    }

    .ww-contact-company h3 {
      font-size: 24px;
    }

    .ww-contact-address,
    .ww-contact-gstin,
    .ww-contact-support p,
    .ww-contact-hours p {
      font-size: 15px;
    }

    .ww-contact-divider {
      margin: 28px 0;
    }

    .ww-contact-details {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ww-contact-details h4 {
      font-size: 18px;
      margin-bottom: 12px;
    }
  }

{% endstylesheet %}

